{
  "version": 2,
  "name": "empiria-bot",
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "DISCORD_TOKEN": "@discord_token",
    "CLIENT_ID": "@client_id",
    "GUILD_ID": "@guild_id"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
